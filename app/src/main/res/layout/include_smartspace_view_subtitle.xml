<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/smartspace_view_subtitle_and_action"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/smartspace_view_space"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/smartspace_view_subtitle_icon"
        android:layout_width="@dimen/smartspace_view_icon_size"
        android:layout_height="@dimen/smartspace_view_icon_size"
        tools:src="@android:drawable/btn_star" />

    <TextView
        android:id="@+id/smartspace_view_subtitle_text"
        style="@style/WidgetSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/smartspace_view_icon_margin"
        android:textAppearance="@style/TextAppearance.Smartspacer.Widget.Subtitle"
        tools:text="Subtitle but it's really really really long"
        tools:textAppearance="@style/TextAppearance.Smartspacer.Widget.Subtitle.Preview" />

    <!-- Continuously scrolling twins of the text, shown instead of it when "Scroll long text" is on and the text is too long. One per speed bucket. Each flipper flips between two identical strips of two text cells (widths set at runtime) so the loop is seamless. -->
    <ViewFlipper
        android:id="@+id/smartspace_view_subtitle_scroll_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:autoStart="true"
        android:clipChildren="true"
        android:flipInterval="4000"
        android:inAnimation="@anim/scroll_text_1"
        android:visibility="gone"
        android:layout_marginStart="@dimen/smartspace_view_icon_margin">

        <LinearLayout
            android:id="@+id/smartspace_view_subtitle_scroll_1_a"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/smartspace_view_subtitle_scroll_1_a_1"
                style="@style/WidgetSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="none"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Smartspacer.Widget.Subtitle" />

            <TextView
                android:id="@+id/smartspace_view_subtitle_scroll_1_a_2"
                style="@style/WidgetSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="none"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Smartspacer.Widget.Subtitle" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/smartspace_view_subtitle_scroll_1_b"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/smartspace_view_subtitle_scroll_1_b_1"
                style="@style/WidgetSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="none"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Smartspacer.Widget.Subtitle" />

            <TextView
                android:id="@+id/smartspace_view_subtitle_scroll_1_b_2"
                style="@style/WidgetSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="none"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Smartspacer.Widget.Subtitle" />

        </LinearLayout>

    </ViewFlipper>

    <ViewFlipper
        android:id="@+id/smartspace_view_subtitle_scroll_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:autoStart="true"
        android:clipChildren="true"
        android:flipInterval="8000"
        android:inAnimation="@anim/scroll_text_2"
        android:visibility="gone"
        android:layout_marginStart="@dimen/smartspace_view_icon_margin">

        <LinearLayout
            android:id="@+id/smartspace_view_subtitle_scroll_2_a"
            android:layout_width="800dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/smartspace_view_subtitle_scroll_2_a_1"
                style="@style/WidgetSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="none"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Smartspacer.Widget.Subtitle" />

            <TextView
                android:id="@+id/smartspace_view_subtitle_scroll_2_a_2"
                style="@style/WidgetSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="none"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Smartspacer.Widget.Subtitle" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/smartspace_view_subtitle_scroll_2_b"
            android:layout_width="800dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/smartspace_view_subtitle_scroll_2_b_1"
                style="@style/WidgetSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="none"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Smartspacer.Widget.Subtitle" />

            <TextView
                android:id="@+id/smartspace_view_subtitle_scroll_2_b_2"
                style="@style/WidgetSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="none"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Smartspacer.Widget.Subtitle" />

        </LinearLayout>

    </ViewFlipper>

    <ViewFlipper
        android:id="@+id/smartspace_view_subtitle_scroll_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:autoStart="true"
        android:clipChildren="true"
        android:flipInterval="16000"
        android:inAnimation="@anim/scroll_text_3"
        android:visibility="gone"
        android:layout_marginStart="@dimen/smartspace_view_icon_margin">

        <LinearLayout
            android:id="@+id/smartspace_view_subtitle_scroll_3_a"
            android:layout_width="1600dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/smartspace_view_subtitle_scroll_3_a_1"
                style="@style/WidgetSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="none"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Smartspacer.Widget.Subtitle" />

            <TextView
                android:id="@+id/smartspace_view_subtitle_scroll_3_a_2"
                style="@style/WidgetSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="none"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Smartspacer.Widget.Subtitle" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/smartspace_view_subtitle_scroll_3_b"
            android:layout_width="1600dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/smartspace_view_subtitle_scroll_3_b_1"
                style="@style/WidgetSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="none"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Smartspacer.Widget.Subtitle" />

            <TextView
                android:id="@+id/smartspace_view_subtitle_scroll_3_b_2"
                style="@style/WidgetSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="none"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Smartspacer.Widget.Subtitle" />

        </LinearLayout>

    </ViewFlipper>

</LinearLayout>